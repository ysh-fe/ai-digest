# ai-digest — environment variables
# Copy to .env and fill in your own values. .env is gitignored.

# Telegram bot that posts the digest (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Chat / channel id to post into (e.g. 123456789 or -1001234567890)
TELEGRAM_CHAT_ID=

# Google AI Studio API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — model used to compile the digest (default: gemma-4-31b-it)
# GEMINI_MODEL=gemma-4-31b-it

# Optional — language the digest is written in (default: Russian).
# Any language name the model understands: English, Deutsch, français, …
# DIGEST_LANGUAGE=Russian

# Optional — date format used in the digest header (default: %d.%m.%Y)
# DIGEST_DATE_FORMAT=%d.%m.%Y
